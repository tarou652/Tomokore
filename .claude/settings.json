{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx nuxi *)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Write(.env*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd c:/code/tomokore && npx prettier --write \"${TOOL_INPUT_FILE_PATH}\" 2>/dev/null || true",
            "statusMessage": "Prettier でフォーマット中..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"${TOOL_INPUT_COMMAND}\" | grep -qE '^(rm -rf|git push --force)' && echo '{\"hookSpecificOutput\":{\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"危険なコマンドはブロックされています\"}}' && exit 1 || exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Claude の応答が完了しました\"",
            "statusMessage": "完了"
          }
        ]
      }
    ]
  }
}
